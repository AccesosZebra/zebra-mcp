# Copiar a .env y rellenar. Nunca se versiona el .env.
# Los secretos se generan con: openssl rand -hex 32

# ── MCP (obligatorio) ──
# Postgres de métricas, con el rol claude_readonly (ver grants.sql)
DATABASE_URL=
# Mínimo 32 caracteres
MCP_AUTH_TOKEN=
PORT=3000

# ── Data Chat (sin estas cuatro, solo funciona el MCP) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SESSION_SECRET=
# URL pública, p. ej. https://datachat.cliente.com
AUTH_BASE_URL=
# Dominio de Google que puede entrar
AUTH_ALLOWED_DOMAIN=

# ── Opcionales ──
# Las claves de IA se pegan en Ajustes, dentro de la plataforma. Estas solo sirven de respaldo:
# mandan mientras no haya una guardada en el panel.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic u openai; solo manda hasta el primer guardado en Ajustes
AI_PROVIDER=
AI_MODEL=

# Conexión de administrador a la base de métricas. Solo sirve para dar permisos de lectura
# (grants.sql) al arrancar y desde Ajustes. Sin ella, se hace a mano.
METRICAS_ADMIN_URL=

# ── Base del dashboard (ajustes, números de WhatsApp y su sesión) ──
# Con docker compose basta la contraseña: compose arma APP_DATABASE_URL hacia su propio Postgres.
APP_DB_PASSWORD=
# Sin compose, la URL completa:
# APP_DATABASE_URL=postgres://usuario:clave@host:5432/base
